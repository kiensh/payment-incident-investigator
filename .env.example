# Default is deterministic mock mode: no model requests, clearly labelled in UI.
INVESTIGATOR_MODE=mock
# Existing loopback bridge; do not point this at an external provider.
BRIDGE_URL=http://localhost:8765
# Populate from GET /cc/v1/models, not an assumed public API model ID.
BRIDGE_MODEL=
# This installed bridge ignores client auth; no token is needed. Never copy its OAuth store.
BRIDGE_TOKEN=
BRIDGE_REQUEST_LIMIT=150
BRIDGE_TIMEOUT_SECONDS=60
# Optional local overrides (defaults shown):
# INVESTIGATOR_DB=data/prepared/incidents.sqlite
# BRIDGE_BUDGET_PATH=artifacts/bridge-budget.sqlite
