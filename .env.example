# Deterministic mock mode makes no model requests. Set live to use the model API.
INVESTIGATOR_MODE=mock

# Anthropic-compatible Messages API. This demo permits local endpoints only.
# Full SDK base URL, including any supported path prefix; /cc is this local setup.
ANTHROPIC_BASE_URL=http://localhost:8765/cc
# Exact model ID from your endpoint's model catalog (GET <base URL>/v1/models).
ANTHROPIC_MODEL=
# Optional API key, sent as x-api-key. The current local endpoint needs no key.
# Keep real credentials in your ignored .env file, never in this example.
ANTHROPIC_API_KEY=

# Application limits: failed model calls count and all usage history is retained.
# persistent: cap across restarts (default). session: fresh cap per server process.
# Use session for local development; restarting/reloading the server resets its allowance.
INVESTIGATOR_BUDGET_SCOPE=persistent
INVESTIGATOR_REQUEST_LIMIT=150
INVESTIGATOR_TIMEOUT_SECONDS=60
# Optional local overrides (defaults shown):
# INVESTIGATOR_DB=data/prepared/incidents.sqlite
# INVESTIGATOR_BUDGET_PATH=artifacts/bridge-budget.sqlite
